<!-- src/Plume/Resources/Colors.Light.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#FFFFFFFF</Color>
    <Color x:Key="SidebarColor">#FFF5F5F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFFFFFFF</Color>
    <Color x:Key="InkColor">#FF1D1D1F</Color>
    <Color x:Key="SecondaryColor">#FF86868B</Color>
    <Color x:Key="TertiaryColor">#FFAEAEB2</Color>
    <Color x:Key="HairlineColor">#17000000</Color>
    <Color x:Key="HoverColor">#11000000</Color>
    <Color x:Key="VioletColor">#FF7C5CFF</Color>
    <Color x:Key="VioletHoverColor">#FF6B4DEB</Color>
    <Color x:Key="StarColor">#FFF5A300</Color>
    <Color x:Key="GreenColor">#FF34C759</Color>
    <Color x:Key="ErrorColor">#FFC0392B</Color>
    <Color x:Key="RawNoteBgColor">#FFF6FBF7</Color>
    <Color x:Key="ProfileSelectedBgColor">#FFFAF9FF</Color>
    <Color x:Key="IconBoxColor">#FFEDEDF2</Color>
    <Color x:Key="NavSelectedColor">#14000000</Color>
    <Color x:Key="CaptionColor">#FFF7F7FA</Color>

    <!-- Pastille flottante : fond des glyphes écoute/traitement (sombre par design, identique aux 2 thèmes),
         glyphe stop au survol, halo bleu du traitement (le halo vert réutilise GreenColor). -->
    <Color x:Key="BadgeOverlayColor">#E6141519</Color>
    <Color x:Key="BadgeStopColor">#FFFFFFFF</Color>
    <Color x:Key="HaloBusyColor">#FF4F8DFF</Color>

    <!-- Brushes définis dans le dico de thème : l'échange clair/sombre remplace ces instances,
         et les consommateurs en DynamicResource se rafraîchissent de façon fiable. -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}"/>
    <SolidColorBrush x:Key="VioletHoverBrush" Color="{StaticResource VioletHoverColor}"/>
    <SolidColorBrush x:Key="StarBrush" Color="{StaticResource StarColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="RawNoteBgBrush" Color="{StaticResource RawNoteBgColor}"/>
    <SolidColorBrush x:Key="ProfileSelectedBgBrush" Color="{StaticResource ProfileSelectedBgColor}"/>
    <SolidColorBrush x:Key="IconBoxBrush" Color="{StaticResource IconBoxColor}"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}"/>
    <SolidColorBrush x:Key="BadgeOverlayBrush" Color="{StaticResource BadgeOverlayColor}"/>
    <SolidColorBrush x:Key="BadgeStopBrush" Color="{StaticResource BadgeStopColor}"/>
</ResourceDictionary>
