<UserControl x:Class="Plume.Views.SettingsPanels.StylePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="600" HorizontalAlignment="Left">
    <StackPanel>
        <TextBlock Text="Styles du menu" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Sélectionne un texte, clique la pastille Plume et choisis un style. Les favoris apparaissent en tête du menu. Glisse une ligne pour changer l'ordre."
                   Style="{StaticResource RowSubtitle}" MaxWidth="520" Margin="2,-12,0,10"/>

        <ListBox x:Name="StyleList" BorderThickness="0" Background="Transparent" AllowDrop="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="10" Padding="11,9"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Pastille d'icône : écrit ou avec voix -->
                                        <Border Grid.Column="0" Style="{StaticResource IconBox}" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource RowIcon}" Text="{Binding IconGlyph}"/>
                                        </Border>
                                        <!-- Étoile favori -->
                                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsFavorite, Mode=TwoWay}"
                                                      Click="FavoriteToggle_Click" Cursor="Hand"
                                                      Background="Transparent" BorderThickness="0"
                                                      Content="{Binding FavGlyph}" FontSize="15" Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" FontSize="13.5"/>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource RowSubtitle}"/>
                                        </StackPanel>
                                        <!-- Interrupteur Visible dans le menu -->
                                        <CheckBox Grid.Column="3" IsChecked="{Binding ShowInMenu, Mode=TwoWay}"
                                                  Click="ShowInMenuToggle_Click" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VioletBrush}"/>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ProfileSelectedBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <Button x:Name="StyleNewButton" Content="+ Nouveau style" HorizontalAlignment="Left"
                Margin="0,4,0,0" Style="{StaticResource SecondaryButton}"/>

        <!-- Éditeur -->
        <Border Style="{StaticResource GroupBorder}" Margin="0,14,0,0">
            <StackPanel>
                <!-- Nom -->
                <StackPanel Margin="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBox}">
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE70F;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Nom"/>
                            <TextBlock Style="{StaticResource RowSubtitle}" Text="Nom affiché dans le menu de la pastille"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="StyleNameBox" Style="{StaticResource FieldTextBox}" Margin="54,8,12,0"/>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="54,0,0,0"/>

                <!-- Instructions (prompt) -->
                <StackPanel Margin="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBox}">
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE70F;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Instructions"/>
                            <TextBlock Style="{StaticResource RowSubtitle}" Text="Le prompt envoyé au modèle pour appliquer ce style"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="StylePromptBox" Style="{StaticResource FieldTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="150"
                             VerticalScrollBarVisibility="Auto" Margin="54,8,12,0"/>
                </StackPanel>

                <!-- Instruction dictée : visible uniquement si ce style l'utilise déjà (Commande vocale) -->
                <StackPanel x:Name="StyleWithVoiceRow">
                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="54,0,0,0"/>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBox}">
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE720;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Instruction dictée"/>
                            <TextBlock Style="{StaticResource RowSubtitle}"
                                       Text="Coché : tu dictes une instruction à appliquer à la sélection (ou à rédiger si rien n'est sélectionné). Décoché : le prompt est appliqué directement à la sélection."/>
                        </StackPanel>
                        <CheckBox Grid.Column="2" x:Name="StyleWithVoiceBox" VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitch}"/>
                    </Grid>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="54,0,0,0"/>

                <!-- Résultat dans une fenêtre : n'écrase jamais la sélection (ex. style Email pro) -->
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBox}">
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8A7;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Résultat dans une fenêtre"/>
                        <TextBlock Style="{StaticResource RowSubtitle}"
                                   Text="Coché : le résultat s'ouvre dans une fenêtre (Copier / Insérer), sans remplacer le texte sélectionné. Décoché : le résultat remplace la sélection."/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" x:Name="StyleWindowBox" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitch}"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="54,0,0,0"/>

                <!-- Créativité -->
                <StackPanel Margin="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconBox}">
                            <TextBlock Style="{StaticResource RowIcon}" Text="&#xE790;"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Créativité"/>
                            <TextBlock Style="{StaticResource RowSubtitle}" Text="0 = fidèle, 1 = plus libre"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="StyleTempValue" Text="0,2" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
                    </Grid>
                    <Slider x:Name="StyleTempSlider" Minimum="0" Maximum="1" Value="0.2" Margin="54,6,12,0"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" SmallChange="0.1" LargeChange="0.2"/>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="54,0,0,0"/>

                <!-- Modèle IA -->
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBox}">
                        <TextBlock Style="{StaticResource RowIcon}" Text="&#xE753;"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Modèle IA de ce style"/>
                        <TextBlock Style="{StaticResource RowSubtitle}" Text="« Par défaut » utilise le modèle de nettoyage global (onglet Général)"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="StyleModelBox" MinWidth="200" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="StyleFormError" Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="12,6,12,0"/>

                <StackPanel Orientation="Horizontal" Margin="12,8,12,12">
                    <Button x:Name="SaveStyleButton" Content="Enregistrer" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="CancelStyleButton" Content="Annuler" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}" Visibility="Collapsed"/>
                    <Button x:Name="StyleDeleteButton" Content="Supprimer" Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
