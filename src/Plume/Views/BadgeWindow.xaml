<Window x:Class="Plume.Views.BadgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="72" Height="72"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="Transparent"
        Title="Plume">
    <!-- Fenêtre 72 px, pastille 44 px centrée : la marge transparente laisse la place
         au grossissement au survol ET au halo bleu (écoute/traitement) sans être coupés. -->
    <Grid Background="Transparent">
        <Grid x:Name="Card" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
              Cursor="Hand" Opacity="0.85" RenderTransformOrigin="0.5,0.5"
              MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- Repos : logo Plume plein rond -->
            <Ellipse x:Name="Glyph">
                <Ellipse.Fill>
                    <ImageBrush x:Name="LogoBrush" Stretch="UniformToFill"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Écoute : fond sombre + 3 barres vertes (aucun texte). Au survol : ■ (stop). -->
            <Grid x:Name="ListenGlyph" Visibility="Collapsed">
                <Ellipse Fill="{DynamicResource BadgeOverlayBrush}"/>
                <StackPanel x:Name="ListenBars" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Rectangle x:Name="Bar1" Width="4" Height="10" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{DynamicResource GreenBrush}"/>
                    <Rectangle x:Name="Bar2" Width="4" Height="18" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{DynamicResource GreenBrush}"/>
                    <Rectangle x:Name="Bar3" Width="4" Height="12" RadiusX="2" RadiusY="2" Margin="2,0" Fill="{DynamicResource GreenBrush}"/>
                </StackPanel>
                <TextBlock x:Name="ListenStop" Text="■" FontSize="15" Foreground="{DynamicResource BadgeStopBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <!-- Traitement : fond sombre + arc violet en rotation (aucun texte) -->
            <Grid x:Name="BusyGlyph" Visibility="Collapsed">
                <Ellipse Fill="{DynamicResource BadgeOverlayBrush}"/>
                <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SpinRot"/>
                    </Canvas.RenderTransform>
                    <Path Stroke="{DynamicResource VioletBrush}" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 9,1 A 8,8 0 1 1 1,9"/>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</Window>
