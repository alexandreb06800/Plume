<Window x:Class="Plume.Views.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plume — Assistant" Width="460" Height="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}" Background="{DynamicResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Assistant vocal" Style="{StaticResource PageTitle}"/>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="1" CornerRadius="12" Padding="12">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Conversation"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="Hint" VerticalAlignment="Center"
                       Foreground="{DynamicResource TertiaryBrush}" FontSize="11" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="InsertButton" Content="Coller la réponse" MinWidth="120" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button Grid.Column="2" x:Name="CopyButton" Content="Copier" MinWidth="80" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}"/>
            <Button Grid.Column="3" x:Name="CloseButton" Content="Fermer" MinWidth="80"
                    Style="{StaticResource SecondaryButton}"/>
        </Grid>
    </Grid>
</Window>
