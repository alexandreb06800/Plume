<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Plume</AssemblyName>
    <RootNamespace>Plume</RootNamespace>
    <Version>5.4.18</Version>
    <ApplicationIcon>Resources\plume.ico</ApplicationIcon>
    <!-- PublishReadyToRun volontairement NON activé : mesuré le 2026-10-09 (.NET 10), exe 1,2 → 2,1 Mo
         pour -16 ms au démarrage seulement (WPF est déjà précompilé, le code de Plume est petit). -->
  </PropertyGroup>

  <!-- Version distribuée : aucun symbole de débogage. Sans cela, l'exe embarque le chemin complet du .pdb sur le
       poste de compilation (C:\Users\<nom>\…), donc le nom d'utilisateur Windows de celui qui publie. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\plume.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\plume-logo.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Resources\plume-logo.png')" />
  </ItemGroup>

</Project>
