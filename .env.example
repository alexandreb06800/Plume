# --- Plume : variables d'environnement (gabarit) ---
# Copie ce fichier en `.env` et renseigne ta vraie clé.
# En usage normal, la clé se saisit dans les réglages de l'app (stockée dans
# %APPDATA%\Plume\config.json). Ces variables servent de repli pratique en dév.

# Clé API OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# Modèle de transcription (Whisper via OpenRouter)
PLUME_STT_MODEL=openai/whisper-large-v3-turbo

# Modèle de nettoyage / reformulation (modèle OpenAI via OpenRouter)
# Pas encore choisi ? Laisse cette valeur par défaut, modifiable dans les réglages.
PLUME_CLEANUP_MODEL=openai/gpt-4o-mini
